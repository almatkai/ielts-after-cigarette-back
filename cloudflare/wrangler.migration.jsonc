{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "ab39c7a0ec52f861379630cccb01061f",
  "name": "ielts-migrate-dev",
  "main": "tools/migration-worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "IAC_BLOB_INDEX",
        "class_name": "IACBlobIndex",
        "script_name": "ielts-blob-dev",
      },
      {
        "name": "IAC_BLOB_CHUNKS",
        "class_name": "IACBlobChunks",
        "script_name": "ielts-blob-dev",
      },
      {
        "name": "IAC_STATE",
        "class_name": "IELTSDev",
        "script_name": "ielts-api-dev",
      },
    ],
  },

  "observability": { "enabled": false },
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "ab39c7a0ec52f861379630cccb01061f",
  "name": "ielts-api-dev",
  "main": "runtime/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": { "IAC_REQUIRE_IMPORT": "true" },
  "durable_objects": {
    "bindings": [
      {
        "name": "IAC_BLOB_INDEX",
        "class_name": "IACBlobIndex",
        "script_name": "ielts-blob-dev",
      },
      {
        "name": "IAC_BLOB_CHUNKS",
        "class_name": "IACBlobChunks",
        "script_name": "ielts-blob-dev",
      },
      { "name": "IAC_STATE", "class_name": "IELTSDev" },
      {
        "name": "IAC_AUDIO",
        "class_name": "IACAudio",
        "script_name": "ielts-audio-dev",
      },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IELTSDev"] }],

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
  ],
  "observability": { "enabled": false },
}

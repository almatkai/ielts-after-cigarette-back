# Merge into the deployment's existing env file. Never commit real credentials.
# Compose overlay requires this variable even if only a subset of profiles runs.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
WORKER_DB_MAX_CONNS=5
# Set true only WITH --profile workers or an independently deployed cmd/worker.
WRITING_WORKER_EXTERNAL=false

# PostgreSQL backups must leave this server. Prefer a separate S3/R2 account.
BACKUP_S3_URI=s3://your-private-backup-bucket/iac/postgres
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
# Optional for R2 / MinIO / other S3-compatible storage. HTTPS, not public-read.
BACKUP_AWS_ENDPOINT_URL=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_LOCAL_RETENTION_DAYS=7

# OPTIONAL docker-compose.server.yml: same-host MinIO, NOT disaster recovery.
# Supply a verified source-built image or an existing immutable official image.
BACKUP_MINIO_IMAGE=your-verified-minio-image
BACKUP_MINIO_ROOT_USER=iac-storage-admin
BACKUP_MINIO_ROOT_PASSWORD=replace-with-an-independent-long-random-password
# Use restricted write-only service credentials for BACKUP_AWS_* above, not root.

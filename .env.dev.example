# Copy to .env.dev and supply credentials privately. Never commit .env.dev.
# The external PostgreSQL endpoint currently does not offer TLS.
# sslmode=disable is for temporary development with synthetic data only.
# Prefer provider TLS (verify-full + CA) or an encrypted tunnel for real data.
DATABASE_URL=postgres://farkhat1:REPLACE_PASSWORD@a1-postgres1.alem.ai:30100/ielts?sslmode=disable&connect_timeout=10
APP_ENV=development
REQUEST_TIMEOUT=60s
# External AI/SMS calls are disabled until deliberately configured.
OPENROUTER_API_KEY=
INFOBIP_ENABLED=false

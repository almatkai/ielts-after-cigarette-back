# Copy to .env.dev and supply credentials privately. Never commit .env.dev.
# The external PostgreSQL endpoint currently does not offer TLS.
# sslmode=disable is for temporary development with synthetic data only.
# Prefer provider TLS (verify-full + CA) or an encrypted tunnel for real data.
DATABASE_URL=postgres://farkhat1:REPLACE_PASSWORD@a1-postgres1.alem.ai:30100/ielts?sslmode=disable&connect_timeout=10
REDIS_URL=redis://:REPLACE_PASSWORD@REPLACE_REDIS_HOST:REPLACE_PORT/0
APP_ENV=development
REQUEST_TIMEOUT=60s
# Audio and speaking uploads use a separate deadline because shared object
# storage can be slower than regular JSON API calls.
MEDIA_UPLOAD_TIMEOUT=5m
MAX_MEDIA_UPLOAD_BYTES=52428800
# A shared team database needs shared object storage as well. Do not point a
# team environment at localhost unless every developer intentionally has
# separate media. Endpoint must not include http:// or https://.
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_ENDPOINT=REPLACE_SHARED_MINIO_HOST:9000
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_SECRET_KEY
OBJECT_STORAGE_BUCKET=ielts-media-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=true
# OpenAI-compatible AI provider. Disable audio for text-only Qwen models.
AI_API_KEY=
AI_CHAT_COMPLETIONS_URL=https://REPLACE_AI_HOST/v1/chat/completions
AI_MODEL=REPLACE_MODEL
AI_SPEAKING_MODEL=REPLACE_MODEL
AI_SPEAKING_AUDIO_ENABLED=false
AI_TIMEOUT=60s
INFOBIP_ENABLED=false

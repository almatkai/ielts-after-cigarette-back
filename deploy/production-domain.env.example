# Non-secret domain overlay for the EXISTING production configuration.
# Not a complete production.env; do not replace credentials or service identities.
CORS_ALLOWED_ORIGINS=https://ielts.yrys.academy
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=lax
TURNSTILE_HOSTNAMES=ielts.yrys.academy
# Keep the SAME existing OAuth web client, matching the frontend constant.
# Set GOOGLE_CLIENT_ID in the GitHub production Environment; do not rotate it.
# GOOGLE_CLIENT_ID=<existing-web-client-id>
# Host nginx template is sized to these existing backend defaults.
REQUEST_TIMEOUT=60s
MEDIA_UPLOAD_TIMEOUT=5m
MAX_REQUEST_BODY_BYTES=1048576
MAX_MEDIA_UPLOAD_BYTES=52428800

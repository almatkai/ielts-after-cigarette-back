APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://ielts:local-postgres-password@localhost:5432/ielts?sslmode=disable
# Per API/worker process; budget total connections across replicas.
DB_MAX_CONNS=20
# Empty by default. Bind to loopback locally; :9090 only on a private Docker network.
METRICS_ADDR=
# true ONLY after cmd/worker is deployed (otherwise Writing jobs wait forever).
WRITING_WORKER_EXTERNAL=false
REDIS_URL=redis://:local-redis-password@localhost:6379/0
JWT_SECRET=replace-this-with-at-least-32-random-characters
PHONE_VERIFICATION_SECRET=replace-this-with-a-different-32-character-secret
JWT_ISSUER=ielts-api
JWT_AUDIENCE=ielts-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=ielts_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=60s
MEDIA_UPLOAD_TIMEOUT=5m
MAX_REQUEST_BODY_BYTES=1048576
LISTENING_MEDIA_DIR=./var/listening-media
WRITING_MEDIA_DIR=./var/writing-media
SPEAKING_MEDIA_DIR=./var/speaking-media
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_ACCESS_KEY=local-minio-admin
OBJECT_STORAGE_SECRET_KEY=local-minio-password
OBJECT_STORAGE_BUCKET=ielts-media
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false
MAX_MEDIA_UPLOAD_BYTES=52428800
DAILY_LIMIT_ASSISTANT=100
DAILY_LIMIT_GUEST_ASSISTANT=15
DAILY_LIMIT_WRITING=25
DAILY_LIMIT_SPEAKING=25
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
PHONE_CODE_TTL=5m
PHONE_TOKEN_TTL=10m
PHONE_RESEND_INTERVAL=1m
PHONE_MAX_ATTEMPTS=5
INFOBIP_BASE_URL=https://l2vz85.api.infobip.com
INFOBIP_ENABLED=false
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WHATSAPP_TEMPLATE=
INFOBIP_WHATSAPP_LANGUAGE=en
INFOBIP_TIMEOUT=10s

# Database AI provider keys: base64 32-byte key, generated with openssl rand -base64 32.
# Keep it in the deployment secret store, OUTSIDE database backups; same key on API/worker.
# SENTRY_DSN (GlitchTip) is required except for explicit development opt-out.
# Never enable this flag in production.
AI_PROVIDER_TELEMETRY_OPTIONAL=false
AI_PROVIDER_ENCRYPTION_KEY=
AI_PROVIDER_PREVIOUS_ENCRYPTION_KEY=
SENTRY_DSN=
SENTRY_WORKER_DSN=

# AI assessment via an OpenAI-compatible chat completions API.
# AI_* takes precedence; OPENROUTER_* remains supported for compatibility.
AI_API_KEY=
AI_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openrouter/free
AI_SPEAKING_MODEL=thinkingmachines/inkling-small:free
AI_SPEAKING_AUDIO_ENABLED=false
SPEECH_ENABLED=false
SPEECH_SERVICE_URL=http://speech-service:8001
SPEECH_SERVICE_TOKEN=change-me-speaking-service-token
SPEECH_TIMEOUT=5m
SPEECH_MODEL=small.en
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
AI_TIMEOUT=45s
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SPEAKING_MODEL=thinkingmachines/inkling-small:free
OPENROUTER_TIMEOUT=45s

# OAuth 2.0 client ID for Google sign-in (verifies ID token audiences)
GOOGLE_CLIENT_ID=
# Comma-separated emails allowed to GET /api/v1/admin/waitlist (Google sign-in)
SUPER_ADMIN_EMAILS=
POSTGRES_USER=ielts
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=ielts
POSTGRES_PORT=5432
REDIS_PASSWORD=local-redis-password
REDIS_PORT=6379
BACKEND_PORT=8080
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SUPER_ADMIN_EMAILS=farhatw140@gmail.com
